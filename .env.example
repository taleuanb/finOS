# 1 = données de démonstration (FakeRepo) quand NOTION_TOKEN est vide ; à laisser vide en production
WOS_DEMO=
# Jeton de l'intégration Notion (accès à la seule page « Patrimoine »)
NOTION_TOKEN=
# Identifiant de la page WEALTH existante, sous laquelle le script setup-notion crée la page « Patrimoine » et ses bases
NOTION_PARENT_PAGE_ID=
# Identifiants des sources de données Notion (affichés par scripts/setup-notion.ts)
NOTION_DB_ASSETS=
NOTION_DB_MOVEMENTS=
NOTION_DB_DEBTS=
NOTION_DB_BUDGET=
NOTION_DB_STRATEGY=
NOTION_DB_PLAN=
NOTION_DB_HISTORY=
# Mot de passe unique de l'application
APP_PASSWORD=
# Secret de signature du cookie de session (chaîne aléatoire ≥ 32 caractères)
SESSION_SECRET=
# Secret accepté par /api/sync pour le Cron Vercel
CRON_SECRET=
# Liens facultatifs vers les bases Notion (accès rapides vers Notion depuis les écrans Patrimoine et Épargne)
NEXT_PUBLIC_NOTION_ASSETS_URL=
NEXT_PUBLIC_NOTION_STRATEGY_URL=
